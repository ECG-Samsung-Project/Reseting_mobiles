# Conexões SSH/SFTP disponíveis na interface
ECG_SYNC_DEFAULT_CONNECTION=external
ECG_SYNC_EXTERNAL_HOST=servidor-externo.exemplo
ECG_SYNC_EXTERNAL_PORT=22
ECG_SYNC_LAB_HOST=servidor-laboratorio.exemplo
ECG_SYNC_LAB_PORT=22
ECG_SYNC_USER=seu_usuario
ECG_SYNC_AUTH_METHOD=auto

# Modos: auto, password ou key. No modo password, a interface solicita a senha
# se ECG_SYNC_PASSWORD ficar vazio.
ECG_SYNC_PASSWORD=
ECG_SYNC_PRIVATE_KEY=
ECG_SYNC_PRIVATE_KEY_PASSPHRASE=

# A identidade do servidor deve estar previamente registrada neste arquivo.
ECG_SYNC_KNOWN_HOSTS=
ECG_SYNC_ALLOW_AGENT=true
ECG_SYNC_LOOK_FOR_KEYS=true
ECG_SYNC_CONNECT_TIMEOUT_SECONDS=20

# Datalake local e remoto
ECG_SYNC_LOCAL_RAW_ROOT=C:\caminho\para\datalake\landing\raw
ECG_SYNC_REMOTE_RAW_ROOT=/mnt/ecg-dados/datalake/landing/raw
ECG_SYNC_FOLDERS=mobile_fl_data,mobile_ic_data,watch_fl_data,watch_ic_data,ecg_data,holter_data,looper_data,eco_data,redcap_data,blood_test_data,bio_data

# Se sha256sum não estiver disponível no Linux, o tamanho ainda será validado.
ECG_SYNC_VERIFY_SHA256=true
